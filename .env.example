# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-here

# Public URL, without trailing slash
PUBLIC_BASE_URL=https://your-domain.example.com

# AI provider: generic_http | gemini | minimax | openrouter
AI_PROVIDER=generic_http
AI_API_KEY=your-ai-api-key-here
AI_BASE_URL=http://127.0.0.1:8080
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Google Sheets inventory
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SHEET_TAB_NAME=Sheet1

# Use one of the following service account options:
# 1) local/self-hosted file path
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# 2) deployment env string, preferred for Vercel/serverless
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=

# Optional SSL certificate path for Telegram webhook if self-hosting without a public HTTPS provider
WEBHOOK_SSL_CERT=

# Misc
TIMEZONE=Asia/Jerusalem
